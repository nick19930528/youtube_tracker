# 複製為 .env 後可覆寫 docker-compose 預設（勿將含真實密碼的 .env 提交版控）

WEB_PORT=8888

# 本機 Docker Compose：Web 容器內請用服務名 db（MySQL 未對主機開埠，僅容器互通）
DB_HOST=db
DB_PORT=3306
DB_NAME=youtube_tracker
DB_USER=appuser
DB_PASSWORD=123456

# MariaDB／MySQL root（僅本機開發預設，請勿用於正式環境）
MYSQL_ROOT_PASSWORD=devroot

# ---------- Cloud Run + Cloud SQL（正式環境用主控台／Secret Manager 設定，不必放 .env）----------
# 1. Cloud Run 服務「連線」勾選 Cloud SQL 執行個體（會掛載 /cloudsql/<PROJECT>:<REGION>:<INSTANCE>）
# 2. 環境變數最少設定：
#    DB_NAME、DB_USER、DB_PASSWORD
#    CLOUD_SQL_CONNECTION_NAME=project:region:instance
#    APP_BASE_URL=https://tubelog.xyz
#    CRON_SECRET=請改成長隨機字串
#    YOUTUBE_API_KEY、OPENAI_API_KEY（建議用 Secret）
#    MAIL_SMTP_* 、 MPG_* 金流
# 3. SESSION_DRIVER 在 Cloud Run 預設為 db（session 存在 Cloud SQL）
# 4. 健康檢查：/scripts/health.php ；連庫檢查：/scripts/health.php?db=1
# 5. Cloud Scheduler：
#    /scripts/fetch_new_videos_all_users.php
#    /scripts/sync_subscription_expiry_all.php
#    Header: X-Cron-Secret: <CRON_SECRET>
#
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
# DB_SOCKET=/cloudsql/project:region:instance
# SESSION_DRIVER=db
# CRON_SECRET=

# 大頭照（Cloud Storage）
# Cloud Run 請建立儲存桶（建議 asia-east1），並給服務帳號「Storage 物件管理員」
# 若大頭照要公開顯示：儲存桶權限加上 allUsers = Storage 物件檢視者
# GCS_BUCKET=tubelog-avatars
# GCS_PUBLIC_BASE=https://storage.googleapis.com/tubelog-avatars

# 驗證信連結（勿結尾斜線）
APP_BASE_URL=https://tubelog.xyz

# PHPMailer／Gmail：MAIL_SMTP_USER 為完整信箱，MAIL_SMTP_PASSWORD 為應用程式密碼（可含空格）
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TubeLog
